# A backend/.env sablonja az éles (Plesk) szerverhez. A tényleges backend/.env NEM kerül a repóba:
# a szerveren egyszer kell létrehozni (Plesk → Laravel Toolkit → Environment variables), a titkos értékekkel.
APP_NAME="Vigadó Mozi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.vigadomozi.hu
# A nyilvános (Angular) alkalmazás címe: fizetés utáni átirányításokhoz
FRONTEND_URL=https://vigadomozi.hu

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Levélküldés: a Plesk szerver saját levelezője (a feladó domainhez SPF/DKIM szükséges)
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=noreply@vigadomozi.hu
MAIL_FROM_NAME="Vigadó Mozi"

# Online fizetés: Stripe (a SimplePay kapcsolati adatai a Beállítások menüben adhatók meg)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
