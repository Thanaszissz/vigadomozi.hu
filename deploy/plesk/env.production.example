# A backend/.env sablonja az éles (Plesk) szerverhez. A tényleges backend/.env NEM kerül a repóba:
# a szerveren egyszer kell létrehozni (Plesk → Laravel Toolkit → Environment variables), a titkos értékekkel.
APP_NAME="Vigadó Jegy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.vigadojegy.hu
# A nyilvános (Angular) alkalmazás címe: fizetés utáni átirányításokhoz
FRONTEND_URL=https://vigadojegy.hu

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Levélküldés: a Plesk szerver saját levelezője (a feladó domainhez SPF/DKIM szükséges)
MAIL_MAILER=sendmail
# Valós, létező postafiók a saját domainen (a no-reply cím rontja a kézbesíthetőséget)
MAIL_FROM_ADDRESS=info@vigadojegy.hu
MAIL_REPLY_TO_ADDRESS=info@vigadojegy.hu
# Kézbesíthetőség (Gmail): SPF + DKIM + DMARC kell. Az alkalmazás tud DKIM-aláírni:
#   php artisan mail:dkim-generate   (kulcsot ad az alábbi változókhoz és a DNS-be kerülő TXT rekordot)
#   php artisan mail:check --send=cimed@gmail.com   (ellenőrzés + teszt levél)
# MAIL_DKIM_DOMAIN=vigadojegy.hu
# MAIL_DKIM_SELECTOR=vigado
# MAIL_DKIM_PRIVATE_KEY=
MAIL_FROM_NAME="Vigadó Jegy"

# Online fizetés: Stripe (a SimplePay kapcsolati adatai a Beállítások menüben adhatók meg)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
