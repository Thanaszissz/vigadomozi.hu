# Az éles (vigadomozi.hu) Angular alkalmazás SPA-útválasztása és gyorsítótárazása.
# Az Angular build ezt a fájlt a kimenet gyökerébe másolja (angular.json assets).
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # A sitemap dinamikusan készül (a műsoron lévő filmekből)
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Létező fájlok és könyvtárak közvetlenül
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Közösségi megosztás előnézete (Facebook, Messenger, WhatsApp, X, LinkedIn, Viber, Telegram...): ezek a robotok
    # nem futtatnak JavaScriptet, ezért oldalanként saját cím/leírás/kép kerül nekik (share.php)
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|meta-externalagent|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|discordbot|pinterest|skypeuripreview|viber|redditbot|embedly|vkshare|applebot) [NC]
    RewriteRule ^(.*)$ share.php?path=/$1 [L]

    # Minden más az Angular alkalmazásé
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # Az index.html mindig friss, a hash-elt fájlok hosszan gyorsítótárazhatók
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
